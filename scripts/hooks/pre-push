#!/usr/bin/env bash
# pre-push hook — installed by scripts/setup-hooks.sh
#
# Builds, then blocks the push if it introduces any test failure that origin/main does not
# already have. The bar is NOT-WORSE, not green — see scripts/hooks/lib/not-worse-gate.sh.
#
# To bypass in an emergency (last resort):
#   git push --no-verify
# Do NOT use --no-verify routinely. Fix the error instead.
#
# It should now be rare to need it: the gate no longer demands a green suite, only that you do not
# make things worse. If you find yourself reaching for --no-verify often, that is evidence about the
# gate rather than about you — say so rather than building the habit.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# GIT SETS THESE WHEN IT RUNS A HOOK, AND EVERY CHILD PROCESS INHERITS THEM.
#
# GIT_DIR in particular OVERRIDES cwd-based repository discovery, so a `git` call that passes
# `cwd: <a temp dir>` — which reads as perfectly scoped — writes into the repository being
# pushed instead. The test suite does exactly that, so running the suite THROUGH THIS HOOK
# rewrites the branch the hook is gating.
#
# Measured 2026-09-04 on tests/unit/lifecycle/legacy-status.test.ts, one variable changed:
#   without GIT_DIR:  45/45 pass, 0 commits, 0 files dirty
#   with    GIT_DIR:  3 fail, FIVE "fixture" commits on HEAD, 29 files dirty
# The three failures are caused by the leak too, so the hook was manufacturing the very red it
# then refused to push on.
#
# Unset here rather than only in the tests: this is the ONE place that protects every test,
# including the ones that do not exist yet. The tests are hardened separately, because a test
# that is only safe when its caller behaves is not a safe test.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH

# THE SAME DEFECT, A DIFFERENT VARIABLE FAMILY — AND THE ONE ABOVE ENUMERATED THE WRONG ONE.
#
# A push run from inside a live cortextOS agent shell leaks that agent's real CTX_ROOT,
# CTX_AGENT_DIR, CTX_ORG, CTX_FRAMEWORK_ROOT and friends into `npm test`. A test that sandboxes
# only SOME of them — CTX_FRAMEWORK_ROOT into a temp dir, say — then inherits the LIVE value for
# the rest, and the framework's containment check refuses:
#
#   Resolved CTX_AGENT_DIR '…/orgs/ygs-cortex-fleet/agents/sentinel' is not under
#   CTX_FRAMEWORK_ROOT '/tmp/…'. Refusing to proceed.
#
# Measured 2026-09-09 pushing PR #39, from this seat:
#   with    CTX_*:  29 failed / 2754 passed / 3 skipped
#   without CTX_*:   0 failed / 2783 passed / 3 skipped
# Totals identical at 2786 both ways — 29 tests flipped by ENVIRONMENT, not by any code change.
#
# ⛔ THOSE 29 ARE A SAFETY GUARD FIRING CORRECTLY, NOT NOISE. The refusal is the framework
# declining to let a sandboxed test touch a live seat's directory. The thing to preserve is the
# REFUSAL; the thing to remove is the leak that provokes it. Anything that makes the 29 stop
# being red WITHOUT removing the leak — a comparison that runs base and head in the same leaked
# environment, for instance — keeps the hazard and hides the alarm, and reads identically from
# the push receipt.
#
# UNSET DYNAMICALLY, never a hardcoded list (shape adopted from upstream #966): a CTX_ variable
# added next month is covered here with no maintenance. A hardcoded list is a claim about the
# members you happened to remember, which is exactly how the GIT_* line above came to be correct
# and incomplete on the same day.
for _leaked_ctx_var in $(compgen -v CTX_ || true); do
  unset "$_leaked_ctx_var"
done
unset _leaked_ctx_var

# THE BAR IS "NOT WORSE", NOT "GREEN".
#
# This hook used to require a fully green suite. `main` has not been green for some time, so the gate
# was unpassable BY CONSTRUCTION: every push, including pushes that fixed things, needed --no-verify.
# A gate that must be bypassed to do ordinary work stops being a gate — people learn the bypass, and
# then it is not there on the day it would have caught something. Measured on this repo: the suite ran
# 30 failing entries on main while a branch adding 11 passing tests was refused.
#
# So the question changed from "is the suite green" to "does this branch introduce a failure that
# origin/main does not already have". See scripts/hooks/lib/not-worse-gate.sh for the full reasoning,
# including why the baseline is pinned by ref and built like-for-like, and why it fails CLOSED.
exec "$REPO_ROOT/scripts/hooks/lib/not-worse-gate.sh"
